<?xml version="1.0" encoding="ISO-8859-1"?>
<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="beans.xsd">

	<bean class="sap.commerce.cx.occ.dto.contact.ContactWsDTO">
		<description>Data transfer object representing the contact form submission.
			Contains customer contact details and message information submitted via the contact page.</description>
		<hints>
			<hint name="wsRelated"/>
			<hint name="alias">ContactWsDTO</hint>
		</hints>
		<property name="email" type="String"/>
		<property name="firstName" type="String"/>
		<property name="lastName" type="String"/>
		<property name="subject" type="String"/>
		<property name="message" type="String"/>
	</bean>

	<bean class="sap.commerce.cx.occ.dto.dashboard.CxDashboardConfigWsDTO">
		<description>Data transfer object representing the Configuration of Dashboards.
			Contains widget config and other information regarding customization of dashboard page.</description>
		<hints>
			<hint name="wsRelated"/>
			<hint name="alias">DashboardConfigWsDTO</hint>
		</hints>
		<property name="code" type="String"/>
		<property name="name" type="String"/>
		<property name="active" type="boolean"/>
		<property name="position" type="int"/>
		<property name="widgetConfigs" type="java.util.List&lt;sap.commerce.cx.occ.dto.dashboard.CxDashboardWidgetConfigWsDTO&gt;"/>
	</bean>

	<bean class="sap.commerce.cx.occ.dto.dashboard.CxDashboardWidgetConfigWsDTO">
		<description>Data transfer object representing the Configuration of Dashboard Widgets.
			Contains information about positioning and size of widgets to be displayed on dashboard page.</description>
		<hints>
			<hint name="wsRelated"/>
			<hint name="alias">DashboardWidgetConfigWsDTO</hint>
		</hints>
		<property name="position" type="int"/>
		<property name="columnSpan" type="int"/>
		<property name="rowSpan" type="int"/>
		<property name="widget" type="sap.commerce.cx.occ.dto.dashboard.CxDashboardWidgetWsDTO"/>
		<property name="settings" type="java.util.List&lt;sap.commerce.cx.occ.dto.dashboard.CxDashboardWidgetSettingWsDTO&gt;">
			<description>Generic widget-specific settings as key-value pairs.</description>
		</property>
	</bean>

	<bean class="sap.commerce.cx.occ.dto.dashboard.CxDashboardWidgetSettingWsDTO">
		<description>Data transfer object representing the Configuration of Dashboard Widget Settings.
			Contains information about key-value pairs for widget settings.</description>
		<hints>
			<hint name="wsRelated"/>
			<hint name="alias">DashboardWidgetSettingWsDTO</hint>
		</hints>
		<property name="key" type="String"/>
		<property name="value" type="String"/>
	</bean>

	<bean class="sap.commerce.cx.occ.dto.dashboard.CxDashboardWidgetWsDTO">
		<property name="code" type="String"/>
		<property name="displayName" type="String"/>
		<property name="contentComponentUid" type="String"/>
		<property name="contentComponentType" type="String"/>
		<property name="minColumnSpan" type="int"/>
		<property name="minRowSpan" type="int"/>
		<property name="multipleOccurrenceAllowed" type="boolean"/>
	</bean>

	<bean class="de.hybris.platform.b2bwebservicescommons.dto.company.OrgUserRegistrationDataWsDTO">
		<property name="telephone" type="String">
			<description>The contact phone number of the user.</description>
		</property>
		<property name="companyName" type="String">
			<description>The name of the company.</description>
		</property>
		<property name="companyAddressStreet" type="String">
			<description>The primary address line.</description>
		</property>
		<property name="companyAddressStreetLine2" type="String">
			<description>The secondary address line.</description>
		</property>
		<property name="companyAddressCity" type="String">
			<description>The city or town.</description>
		</property>
		<property name="companyAddressPostalCode" type="String">
			<description>The postal code.</description>
		</property>
		<property name="companyAddressRegion" type="String">
			<description>The region/state.</description>
		</property>
		<property name="companyAddressCountryIso" type="String">
			<description>The country (ISO-3166-1 alpha-2).</description>
		</property>
		<property name="ustId" type="String">
			<description>The VAT identification number.</description>
		</property>
	</bean>

	<!-- News -->
	<bean class="sap.commerce.cx.occ.dto.news.CxNewsWsDTO">
		<property name="id" type="String"/>
		<property name="title" type="String"/>
		<property name="shortDescription" type="String"/>
		<property name="teaserImage" type="de.hybris.platform.cmsocc.data.MediaWsDTO"/>
		<property name="url" type="String"/>
		<property name="creationTime" type="java.util.Date"/>
	</bean>

	<bean class="sap.commerce.cx.occ.dto.news.CxNewsListWsDTO">
		<property name="news" type="java.util.List&lt;sap.commerce.cx.occ.dto.news.CxNewsWsDTO&gt;"/>
	</bean>

	<bean class="de.hybris.platform.commercewebservicescommons.dto.order.SAPSavedCartRequestWsDTO">
		<property name="keepActiveCart" type="boolean">
			<description>Decides if the Active cart should stay active after the save</description>
		</property>
	</bean>

	<!--Solr -->
	<bean class="de.hybris.platform.commercewebservicescommons.dto.search.facetdata.FacetWsDTO">
		<property name="facetDisplayType" type="String"/>
		<property name="type" type="String"/>
		<property name="from" type="String"/>
		<property name="to" type="String"/>
		<property name="solrStatsField" type="sap.commerce.cx.occ.dto.solr.SolrStatsFieldWsDTO"/>
		<property name="removeQuery" type="de.hybris.platform.commercewebservicescommons.dto.search.SearchStateWsDTO"/>
	</bean>

	<bean class="sap.commerce.cx.occ.dto.solr.SolrStatsFieldWsDTO">
		<property name="name" type="java.lang.String"/>
		<property name="min" type="java.lang.Double"/>
		<property name="max" type="java.lang.Double"/>
		<property name="count" type="java.lang.Long"/>
	</bean>
	<!--End of Solr -->

    <bean class="de.hybris.platform.commercewebservicescommons.dto.order.OrderWsDTO">
        <property name="trackingUrl" type="String">
            <description>Tracking URL associated with the Order. The Tracking URL is present if the order was shipped.
            </description>
            <hints>
                <hint name="example">https://www.ups.com/track?tracknum=123456789</hint>
            </hints>
        </property>
    </bean>

	<!-- ** Service Ticket ** -->
    <bean class="sap.commerce.cx.occ.dto.serviceticket.ServiceTicketCountWsDTO">
        <property name="openRequests" type="int"/>
        <property name="closedRequests" type="int"/>
    </bean>

    <bean class="sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketWsDTO">
		<property name="code" type="java.lang.String"/>
		<property name="type" type="java.lang.String"/>
		<property name="typeCode" type="java.lang.String"/>
		<property name="status" type="java.lang.String"/>
		<property name="title" type="java.lang.String"/>
		<property name="description" type="java.lang.String"/>
		<property name="machines"
		          type="java.util.List&lt;de.hybris.platform.commercewebservicescommons.dto.product.ProductWsDTO&gt;"/>
		<property name="allMachines" type="java.lang.Boolean"/>
		<property name="customer" type="de.hybris.platform.commercewebservicescommons.dto.user.UserWsDTO"/>
		<property name="creationTime" type="java.util.Date"/>
		<property name="isNew" type="java.lang.Boolean"/>
		<property name="parentAccountGroup" type="de.hybris.platform.b2bwebservicescommons.dto.company.B2BUnitWsDTO"/>
		<property name="form" type="java.lang.String"/>
	</bean>

    <bean class="de.hybris.platform.commercewebservicescommons.dto.search.facetdata.ContentSearchPageWsDTO">
        <description>
            Represents a paginated list of content items and the total count of all matching items
        </description>
        <hints>
            <hint name="wsRelated"/>
            <hint name="alias">ContentSearchPage</hint>
        </hints>
        <property name="sorts"
                  type="java.util.List&lt;de.hybris.platform.commercewebservicescommons.dto.search.pagedata.SortWsDTO&gt;"/>
        <property name="pagination"
                  type="de.hybris.platform.commercewebservicescommons.dto.search.pagedata.PaginationWsDTO"/>
        <property name="currentQuery"
                  type="de.hybris.platform.commercewebservicescommons.dto.search.SearchStateWsDTO"/>
        <property name="breadcrumbs"
                  type="java.util.List&lt;de.hybris.platform.commercewebservicescommons.dto.search.facetdata.BreadcrumbWsDTO&gt;"/>
        <property name="facets"
                  type="java.util.List&lt;de.hybris.platform.commercewebservicescommons.dto.search.facetdata.FacetWsDTO&gt;"/>
    </bean>

    <bean class="de.hybris.platform.commercewebservicescommons.dto.search.facetdata.CxServiceTicketSearchPageWsDTO"
          extends="de.hybris.platform.commercewebservicescommons.dto.search.facetdata.ContentSearchPageWsDTO">
        <description>
            Represents a paginated list of service tickets and the total count of all matching tickets
        </description>
        <hints>
            <hint name="wsRelated"/>
            <hint name="alias">CxServiceTicketSearchPage</hint>
        </hints>
        <property name="results"
                  type="java.util.List&lt;sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketWsDTO&gt;">
            <description>List of service tickets</description>
        </property>
    </bean>

    <bean class="sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketFormDTO">
		<description>Representations of a service request form</description>
		<hints>
			<hint name="wsRelated"/>
            <hint name="alias">CxServiceTicketFormDTO</hint>
		</hints>
		<property name="id" type="java.lang.String"/>
		<property name="title" type="java.lang.String"/>
		<property name="type" type="java.lang.String"/>
		<property name="description" type="java.lang.String"/>
		<property name="recipients" type="java.util.List&lt;java.lang.String&gt;"/>
		<property name="dynamicRecipient" type="java.lang.Boolean"/>
		<property name="formFields"
                  type="java.util.List&lt;sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketFormFieldDTO&gt;"/>
		<property name="machines" type="java.util.List&lt;java.lang.String&gt;"/>
	</bean>

    <bean class="sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketFormFieldDTO">
		<description>Representations of a service request form field</description>
		<hints>
			<hint name="wsRelated"/>
            <hint name="alias">CxServiceTicketFormFieldDTO</hint>
		</hints>
		<property name="id" type="java.lang.String"/>
		<property name="label" type="java.lang.String"/>
		<property name="description" type="java.lang.String"/>
		<property name="required" type="java.lang.Boolean"/>
		<property name="hidden" type="java.lang.Boolean"/>
		<property name="fieldType" type="java.lang.String"/>
		<property name="minValue" type="java.lang.Double"/>
		<property name="maxValue" type="java.lang.Double"/>
		<property name="minLength" type="java.lang.Integer"/>
		<property name="maxLength" type="java.lang.Integer"/>
		<property name="defaultValue" type="java.lang.String"/>
		<property name="placeholder" type="java.lang.String"/>
		<property name="formFieldValues"
                  type="java.util.List&lt;sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketFormFieldValueDTO&gt;"/>
		<property name="value" type="java.lang.String"/>
	</bean>

    <bean class="sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketFormFieldValueDTO">
		<description>Representations of a service request form field value</description>
		<hints>
			<hint name="wsRelated"/>
            <hint name="alias">CxServiceTicketFormFieldValueDTO</hint>
		</hints>
		<property name="id" type="java.lang.String"/>
		<property name="label" type="java.lang.String"/>
		<property name="childFields"
                  type="java.util.List&lt;sap.commerce.cx.occ.dto.serviceticket.CxServiceTicketFormFieldDTO&gt;"/>
	</bean>

	<!-- ** End Service Ticket ** -->
</beans>
