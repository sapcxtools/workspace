<?xml version="1.0" encoding="UTF-8"?><beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"       xsi:schemaLocation="http://www.springframework.org/schema/beans https://www.springframework.org/schema/beans/spring-beans.xsd">    <alias name="cxServiceTicketFacade" alias="cxServiceTicketFacade"/>    <bean id="cxServiceTicketFacade" class="sap.commerce.cx.facades.serviceticket.impl.DefaultCxServiceTicketFacade">        <constructor-arg name="cxServiceTicketService" ref="cxServiceTicketService"/>        <constructor-arg name="cxServiceTicketConverter" ref="cxTicketConverter"/>        <constructor-arg name="cxServiceTicketSearchStrategy" ref="cxServiceTicketSearchStrategy"/>        <constructor-arg name="cxTicketSearchPageConverter" ref="cxTicketSearchPageConverter"/>    </bean>    <alias name="defaultCxTicketSearchPageConverter" alias="cxTicketSearchPageConverter"/>    <bean id="defaultCxTicketSearchPageConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="sap.commerce.cx.core.contentsearch.facetdata.ContentSearchPageData"/>        <property name="populators">            <list>                <ref bean="cxTicketSearchPagePopulator"/>            </list>        </property>    </bean>    <alias name="defaultTicketSearchPagePopulator" alias="cxTicketSearchPagePopulator"/>    <bean id="defaultTicketSearchPagePopulator" class="sap.commerce.cx.core.contentsearch.populator.CxContentSearchPagePopulator">        <constructor-arg name="searchResultConverter" ref="cxSearchResultTicketConverter"/>        <constructor-arg name="searchStateConverter" ref="cxTicketSolrSearchStateConverter"/>        <constructor-arg name="facetConverter" ref="cxTicketFacetConverter"/>        <constructor-arg name="breadcrumbConverter" ref="cxBreadcrumbConverter"/>    </bean>    <alias name="defaultCxBreadcrumbConverter" alias="cxBreadcrumbConverter"/>    <bean id="defaultCxBreadcrumbConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="de.hybris.platform.commerceservices.search.facetdata.BreadcrumbData"/>        <property name="populators">            <list>                <ref bean="cxBreadcrumbPopulator"/>            </list>        </property>    </bean>    <alias name="defaultCxBreadcrumbPopulator" alias="cxBreadcrumbPopulator"/>    <bean id="defaultCxBreadcrumbPopulator"          class="de.hybris.platform.commercefacades.search.converters.populator.BreadcrumbPopulator">        <property name="searchStateConverter" ref="cxTicketSolrSearchStateConverter"/>    </bean>    <alias name="defaultCxTicketFacetConverter" alias="cxTicketFacetConverter"/>    <bean id="defaultCxTicketFacetConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="de.hybris.platform.commerceservices.search.facetdata.FacetData"/>        <property name="populators">            <list>                <ref bean="cxTicketFacetPopulator"/>            </list>        </property>    </bean>    <alias name="defaultCxFacetPopulator" alias="cxTicketFacetPopulator"/>    <bean id="defaultCxFacetPopulator"          class="de.hybris.platform.commercefacades.search.converters.populator.FacetPopulator">        <property name="facetValueConverter" ref="cxTicketFacetValueConverter"/>    </bean>    <alias name="defaultCxTicketFacetValueConverter" alias="cxTicketFacetValueConverter"/>    <bean id="defaultCxTicketFacetValueConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="de.hybris.platform.commerceservices.search.facetdata.FacetValueData"/>        <property name="populators">            <list>                <ref bean="cxTicketFacetValuePopulator"/>            </list>        </property>    </bean>    <alias name="defaultCxTicketFacetValuePopulator" alias="cxTicketFacetValuePopulator"/>    <bean id="defaultCxTicketFacetValuePopulator"          class="de.hybris.platform.commercefacades.search.converters.populator.FacetValuePopulator">        <property name="searchStateConverter" ref="cxTicketSolrSearchStateConverter"/>    </bean>    <bean id="cxSearchResultTicketConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="sap.commerce.cx.facades.data.serviceticket.data.CxServiceTicketData"/>        <property name="populators">            <list>                <ref bean="cxSearchResultTicketPopulator"/>            </list>        </property>    </bean>    <bean id="cxSearchResultTicketPopulator"          class="sap.commerce.cx.facades.serviceticket.converter.populator.CxSearchResultTicketPopulator">        <constructor-arg name="customerFacade" ref="customerFacade"/>        <constructor-arg name="productFacade" ref="productFacade"/>        <constructor-arg name="enumerationService" ref="enumerationService"/>        <constructor-arg name="commonI18NService" ref="commonI18NService"/>    </bean>    <alias name="defaultCxTicketConverter" alias="cxTicketConverter"/>    <bean id="defaultCxTicketConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="sap.commerce.cx.facades.data.serviceticket.data.CxServiceTicketData"/>        <property name="populators">            <list>                <bean class="sap.commerce.cx.facades.serviceticket.converter.populator.CxServiceTicketPopulator">                    <constructor-arg name="machineConverter" ref="productConverter"/>                    <constructor-arg name="customerConverter" ref="b2BCustomerConverter"/>                    <constructor-arg name="b2BUnitConverter" ref="b2bUnitConverter"/>                    <constructor-arg name="enumerationService" ref="enumerationService"/>                    <constructor-arg name="commonI18NService" ref="commonI18NService"/>                </bean>            </list>        </property>    </bean>    <alias name="defaultCxServiceTicketFormFacade" alias="cxServiceTicketFormFacade"/>    <bean id="defaultCxServiceTicketFormFacade"          class="sap.commerce.cx.facades.serviceticket.impl.DefaultCxServiceTicketFormFacade">        <constructor-arg name="cxServiceTicketFormService" ref="cxServiceTicketFormService"/>        <constructor-arg name="cxServiceTicketFormConverter" ref="cxServiceTicketFormConverter"/>    </bean>    <bean id="cxServiceTicketFormConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="sap.commerce.cx.facades.data.serviceticket.data.CxServiceTicketFormData"/>        <property name="populators">            <list>                <bean class="sap.commerce.cx.facades.serviceticket.converter.populator.CxServiceTicketFormPopulator">                    <constructor-arg name="cxServiceTicketFormFieldConverter" ref="cxServiceTicketFormFieldConverter"/>                </bean>            </list>        </property>    </bean>    <bean id="cxServiceTicketFormFieldConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="sap.commerce.cx.facades.data.serviceticket.data.CxServiceTicketFormFieldData"/>        <property name="populators">            <list>                <bean class="sap.commerce.cx.facades.serviceticket.converter.populator.CxServiceTicketFormFieldPopulator">                    <constructor-arg name="cxServiceTicketFormFieldValueConverter" ref="cxServiceTicketFormFieldValueConverter"/>                </bean>            </list>        </property>    </bean>    <bean id="cxServiceTicketFormFieldValueConverter" parent="abstractPopulatingConverter">        <property name="targetClass" value="sap.commerce.cx.facades.data.serviceticket.data.CxServiceTicketFormFieldValueData"/>        <property name="populators">            <list>                <bean class="sap.commerce.cx.facades.serviceticket.converter.populator.CxServiceTicketFormFieldValuePopulator">                    <constructor-arg name="cxServiceTicketFormFieldConverter" ref="cxServiceTicketFormFieldConverter"/>                </bean>            </list>        </property>    </bean>    <bean parent="modifyPopulatorList">        <property name="list" ref="cxTicketFacetConverter"/>        <property name="add" ref="facetDataDisplayTypePopulator"/>    </bean>    <bean id="cxTicketFacetDataRemoveQueryPopulator" class="sap.commerce.cx.facades.solr.populator.FacetDataRemoveQueryPopulator">        <constructor-arg name="searchStateConverter" ref="cxTicketSolrSearchStateConverter"/>    </bean>    <bean parent="modifyPopulatorList">        <property name="list" ref="cxTicketFacetConverter"/>        <property name="add" ref="cxTicketFacetDataRemoveQueryPopulator"/>    </bean>    <bean parent="modifyPopulatorList">        <property name="list" ref="cxTicketFacetConverter"/>        <property name="add" ref="facetDataTypePopulator"/>    </bean>    <bean parent="modifyPopulatorList">        <property name="list" ref="cxTicketFacetConverter"/>        <property name="add" ref="facetDataSolrStatsPopulator"/>    </bean>    <bean parent="modifyPopulatorList">        <property name="list" ref="cxTicketFacetConverter"/>        <property name="add" ref="facetDataFromToValuesPopulator"/>    </bean></beans>