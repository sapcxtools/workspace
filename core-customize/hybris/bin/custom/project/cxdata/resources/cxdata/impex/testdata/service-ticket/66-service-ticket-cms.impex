############################################################# Default Macros############################################################UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]$contentCatalogId = $config-cxdata.import.defaults.catalog.content.id$contentCatalogName = $config-cxdata.import.defaults.catalog.content.name$contentCatalogEditVersion = $config-cxdata.import.defaults.catalog.content.versions.edit$contentCatalogLiveVersion = $config-cxdata.import.defaults.catalog.content.versions.live$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $contentCatalogId]), CatalogVersion.version[default = $contentCatalogEditVersion])[unique = true, default = $contentCatalogId:$contentCatalogEditVersion]############################################################INSERT_UPDATE CxServiceTicketComponent; uid[unique = true]                       ; formId                  ; $contentCV[unique = true]                                       ; CxRequestWarrantyFormComponent          ; requestWarranty         ;                                       ; CxRequestTechnicalSupportFormComponent  ; requestTechnicalSupport ;                                       ; CxRequestComposableGenericFormComponent ; composableGenericForm   ;