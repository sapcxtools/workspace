                                   ; $productCatalogSync ; Category:thumbnails                ; false ; true

# Classification catalog
INSERT_UPDATE ClassificationSystem; id[unique = true]        ; name[lang = $primaryLang]  ; baseStores(uid)
                                  ; $classificationCatalogId ; Classification ($siteName) ; $storeId

INSERT_UPDATE ClassificationSystemVersion; catalog(id)[unique = true]; version[unique = true]            ; active; languages(isoCode); readPrincipals(uid)          ; writePrincipals(uid)            ; inclPacking[virtual = true, default = true]; inclDuty[virtual = true, default = true]; inclFreight[virtual = true, default = true]; inclAssurance[virtual = true, default = true]
                                         ; $classificationCatalogId  ; $classificationCatalogLiveVersion ; true  ; $primaryLang      ; employeegroup, customergroup ; admingroup, productmanagergroup ;                                            ;                                         ;                                            ;

