                                   ; $productCatalogSync ; Product:productDetailComponents    ; false ; true
                                   ; $productCatalogSync ; Product:productFeatureComponents   ; false ; true
                                   ; $productCatalogSync ; Product:productListComponents      ; false ; true
                                   ; $productCatalogSync ; Product:detail                     ; false ; true
                                   ; $productCatalogSync ; Product:logo                       ; false ; true
                                   ; $productCatalogSync ; Product:normal                     ; false ; true
                                   ; $productCatalogSync ; Product:thumbnails                 ; false ; true
                                   ; $productCatalogSync ; Product:thumbnail                  ; false ; true
# Remove not needed Category attributes -> ~ 10% for Category sync
