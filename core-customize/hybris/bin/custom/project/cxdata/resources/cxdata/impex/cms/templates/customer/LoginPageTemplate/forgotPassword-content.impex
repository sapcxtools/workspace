############################################################
# Default Macros
############################################################
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$contentCatalogId = $config-cxdata.import.defaults.catalog.content.id
$contentCatalogName = $config-cxdata.import.defaults.catalog.content.name
$contentCatalogEditVersion = $config-cxdata.import.defaults.catalog.content.versions.edit
$contentCatalogLiveVersion = $config-cxdata.import.defaults.catalog.content.versions.live
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $contentCatalogId]), CatalogVersion.version[default = $contentCatalogEditVersion])[unique = true, default = $contentCatalogId:$contentCatalogEditVersion]

$pageId = forgotPassword
$pageName = Forgot Password Page
$pageLabel = /login/forgot-password
$masterTemplate = LoginPageTemplate
############################################################

INSERT_UPDATE ContentPage; $contentCV[unique = true]; uid[unique = true]; name      ; masterTemplate(uid, $contentCV); label      ; defaultPage[default = 'true']; approvalStatus(code)[default = 'approved']; homepage[default = 'false']
                         ;                          ; $pageId           ; $pageName ; $masterTemplate                ; $pageLabel ;                              ;                                           ;

INSERT_UPDATE ContentSlotForPage; $contentCV[unique = true]; uid[unique = true]  ; position[unique = true]; page(uid, $contentCV)[unique = true][default = $pageId]; contentSlot(uid, $contentCV)[unique = true]
                                ;                          ; $pageId-LeftContent ; LeftContentSlot        ;                                                        ; $pageId-LeftContentSlot

# Create components for page
INSERT_UPDATE CMSFlexComponent; $contentCV[unique = true]; uid[unique = true]      ; name                      ; flexType
                              ;                          ; ForgotPasswordComponent ; Forgot Password Component ; ForgotPasswordComponent

# Add components to content clots
INSERT_UPDATE ContentSlot; $contentCV[unique = true]; uid[unique = true]      ; name                            ; active; cmsComponents(uid, $contentCV)
                         ;                          ; $pageId-LeftContentSlot ; Left Content Slot for $pageName ; true  ; ForgotPasswordComponent
