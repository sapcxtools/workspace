$lang = en

$premiumNet = premium-net
$standardNet = standard-net
$dpd = dpd
$freight = spedition
$pickup = storePickup

UPDATE ZoneDeliveryMode; code[unique = true]; name[lang = $lang]  ; description[lang = $lang]
                       ; $premiumNet        ; "Premium Delivery"  ; "1-2 business days"
                       ; $standardNet       ; "Standard Delivery" ; "3-5 business days"
                       ; $dpd               ; "DPD"               ; "Parcel delivery service"
                       ; $freight           ; "Freight Delivery"  ; "Delivery via freight carrier"
                       ; $pickup            ; "Store Pickup"      ; "Pick up at location"