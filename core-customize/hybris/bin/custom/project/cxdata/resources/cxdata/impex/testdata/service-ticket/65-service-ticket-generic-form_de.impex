$lang = deINSERT_UPDATE CxServiceTicketForm; id[unique = true]     ; title[lang = $lang]                        ; description[lang = $lang]                                  ; composableGenericForm ; "Allgemeines generisches Formular anfordern" ; "Hier können Sie eine Anfrage über ein generisches Formular senden"INSERT_UPDATE CxServiceTicketFormField; id[unique = true]     ; label[lang = $lang]     ; description[lang = $lang]     ; placeholder[lang = $lang]                                       ; formField_string      ; "string-label-de"       ; "string-description-de"       ; "string-placeholder-de"                                       ; formField_number      ; "number-label-de "      ; "number-description-de "      ; "number-placeholder-de"                                       ; formField_radio       ; "radio-label-de "       ; "radio-description-de "       ; "radio-placeholder-de"                                       ; formField_select      ; "select-label-de "      ; "select-description-de "      ; "select-placeholder-de"                                       ; formField_checkbox    ; "checkbox-label-de "    ; "checkbox-description-de "    ; "checkbox-placeholder-de"                                       ; formField_checkboxes  ; "checkboxes-label-de "  ; "checkboxes-description-de "  ; "checkboxes-placeholder-de"                                       ; formField_date_picker ; "date_picker-label-de " ; "date_picker-description-de " ; "date_picker-placeholder-de"INSERT_UPDATE CxServiceTicketFormFieldValue; id[unique = true]           ; label[lang = $lang]                                            ; formFieldValue_radio_1      ; "radio-1-label-de"                                            ; formFieldValue_radio_2      ; "radio-2-label-de"                                            ; formFieldValue_radio_3      ; "radio-3-label-de"                                            ; formFieldValue_radio_4      ; "radio-4-label-de"                   