############################################################
# BeanShell imports
############################################################
"#% impex.setLocale(Locale.ENGLISH);"
"#% import sap.commerce.cx.data.ImpexHelper;"
"#% import org.apache.commons.lang3.StringUtils;"
"#% import org.apache.commons.io.FilenameUtils;"

############################################################
# Default Macros
############################################################
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryCurrency = $config-cxdata.import.defaults.currency.primary
$primaryLang = $config-cxdata.import.defaults.languages.primary
$optionalLang1 = $config-cxdata.import.defaults.languages.optional1
$optionalLang2 = $config-cxdata.import.defaults.languages.optional2
$optionalLang3 = $config-cxdata.import.defaults.languages.optional3
$optionalLang4 = $config-cxdata.import.defaults.languages.optional4
$optionalLang5 = $config-cxdata.import.defaults.languages.optional5
$optionalLang6 = $config-cxdata.import.defaults.languages.optional6
$optionalLang7 = $config-cxdata.import.defaults.languages.optional7
$optionalLang8 = $config-cxdata.import.defaults.languages.optional8
$optionalLang9 = $config-cxdata.import.defaults.languages.optional9
$siteId = $config-cxdata.import.defaults.site.id
$siteName = $config-cxdata.import.defaults.site.name
$storeId = $config-cxdata.import.defaults.store.id
$storeName = $config-cxdata.import.defaults.store.name
$productCatalogId = $config-cxdata.import.defaults.catalog.product.id
$productCatalogName = $config-cxdata.import.defaults.catalog.product.name
$productCatalogEditVersion = $config-cxdata.import.defaults.catalog.product.versions.edit
$productCatalogLiveVersion = $config-cxdata.import.defaults.catalog.product.versions.live
$productCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $productCatalogId]), CatalogVersion.version[default = $productCatalogEditVersion])[unique = true, default = $productCatalogId:$productCatalogEditVersion]
$classificationCatalogId = $config-cxdata.import.defaults.catalog.classification.id
$classificationCatalogName = $config-cxdata.import.defaults.catalog.classification.name
$classificationCatalogLiveVersion = $config-cxdata.import.defaults.catalog.classification.versions.live
$classCatalogVersion = catalogversion(catalog(id[default = '$classificationCatalog']), version[default = '$classificationCatalogLiveVersion'])[unique = true, default = '$classificationCatalog:$classificationCatalogLiveVersion']
$classSystemVersion = systemVersion(catalog(id[default = '$classificationCatalog']), version[default = '$classificationCatalogLiveVersion'])[unique = true, default = '$classificationCatalog:$classificationCatalogLiveVersion']
$class = classificationClass(ClassificationClass.code, $classCatalogVersion)[unique = true]
$mediaResourcePath = jar:sap.commerce.cx.data.ImpexHelper&/cxdata/assets/

############################################################
# Variant 1: Dynamic assignment from CSV
# Use this when data are maintained in CSV
############################################################
# Materials
# 1: Data-Locale
# 2: Material ID
# 3: Product hierarchy
# 4: EAN
# 5: Unit
# 6: Name
############################################################

$lang = $primaryLang

INSERT_UPDATE Product;; code[unique = true]; supercategories(code, $productCV); ean; unit(code); name[lang = $lang]; description[lang = $lang];;;;;;;;; $productCV;;;; approvalStatus(code)[default = 'approved']
"#% beforeEach:
    ImpexHelper.filterUnlocalizedOrPrimaryLine(line, 1, ""$lang"");"
"#% impex.includeExternalData(ImpexHelper.class.getResourceAsStream(""/cxdata/data/Materials.csv"") , ""UTF-8"", new char[]{','}, 1, -1 );"

$lang = $optionalLang1
INSERT_UPDATE Product;; code[unique = true]; supercategories(code, $productCV); ean; unit(code); name[lang = $lang]; description[lang = $lang];;;;;;;;; $productCV;;;; approvalStatus(code)[default = 'approved']
"#% beforeEach:
    ImpexHelper.filterUnlocalizedOrPrimaryLine(line, 1, ""$lang"");"
"#% impex.includeExternalData(ImpexHelper.class.getResourceAsStream(""/cxdata/data/Materials.csv"") , ""UTF-8"", new char[]{','}, 1, -1 );"

$lang = $primaryLang
INSERT_UPDATE Product;; code[unique = true];;;; summary[lang = $lang];;;;;;;;;;;;;; $productCV;;;;
"#% beforeEach:
    ImpexHelper.filterUnlocalizedOrPrimaryLine(line, 1, ""$lang"");"
"#% impex.includeExternalData(ImpexHelper.class.getResourceAsStream(""/cxdata/data/Materials.csv"") , ""UTF-8"", new char[]{','}, 1, -1 );"

$lang = $optionalLang1
INSERT_UPDATE Product;; code[unique = true];;;; summary[lang = $lang];;;;;;;;;;;;;; $productCV;;;;
"#% beforeEach:
    ImpexHelper.filterUnlocalizedOrPrimaryLine(line, 1, ""$lang"");"
"#% impex.includeExternalData(ImpexHelper.class.getResourceAsStream(""/cxdata/data/Materials.csv"") , ""UTF-8"", new char[]{','}, 1, -1 );"

################################################################################
# Variant 2: Static fallback without CSV input
# Use this for quick setup when data are managed directly in this impex.
################################################################################
INSERT_UPDATE Product; code[unique = true]; supercategories(code, $productCV); ean; unit(code); approvalStatus(code)[default = 'approved']; $productCV
#                     ; 100101000001       ; 10010100                         ; 4001234500001 ; PCE       ;                                           ;

INSERT_UPDATE Product; code[unique = true]; name[lang = $primaryLang]; name[lang = $optionalLang1]; summary[lang = $primaryLang]; summary[lang = $optionalLang1]; $productCV
#                     ; 100101000001       ; Eco Flow axial flow pump AX 200 ; Eco Flow Axialpumpe AX 200 ; Eco Flow axial flow pump AX 200 ; Eco Flow Axialpumpe AX 200    ;

INSERT_UPDATE Product; code[unique = true]; description[lang = $primaryLang]; $productCV
#                     ; 100101000001       ; "<p>Our high-performance AX 200 axial flow pump is designed for high flow rates in water and wastewater applications with low heads. The robust design ensures long service life as well as cost-efficient installation and maintenance.</p><h3>Easy installation</h3><p>The AX 200 axial flow pump is installed by simply lowering it into vertical pipe shafts. The specially developed sealing ring closes flush with the flange of the shaft pipe. In most applications, no additional mechanical fixing is required to achieve tightness to the pump sump, but a mechanical connection can be provided as an option.</p><h3>Applications</h3><ul><li>Pumping stations for wastewater (stormwater, floodwater)</li><li>Utility water plants</li><li>Wastewater transport</li><li>Pumping of oil-containing water</li></ul>" ;

INSERT_UPDATE Product; code[unique = true]; description[lang = $optionalLang1]; $productCV
#                     ; 100101000001       ; "<p>Unsere leistungsstarke Axialpumpe AX 200 ist für hohe Volumenströme in Wasser- und Abwasseranwendungen bei geringen Förderhöhen konzipiert. Die robuste Konstruktion zeichnet sich durch hohe Langlebigkeit sowie eine kostengünstige Installation und Wartung aus.</p><h3>Einfache Installation</h3><p>Die Axialpumpe AX 200 wird durch einfaches Einlassen in vertikale Rohrschächte installiert. Der eigens entwickelte Dichtring schließt flächenbündig mit dem Flansch des Schachtrohres ab. In den meisten Anwendungsfällen ist keine zusätzliche mechanische Sicherung erforderlich, um die Dichtigkeit zum Pumpensumpf herzustellen. Optional ist eine mechanische Verbindung möglich.</p><h3>Anwendungsgebiete</h3><ul><li>Pumpenwerke für Schmutzwasser (Starkregen, Hochwasser)</li><li>Nutzwasserwerke</li><li>Abwasserförderung</li><li>Förderung ölhaltigen Wassers</li></ul>" ;