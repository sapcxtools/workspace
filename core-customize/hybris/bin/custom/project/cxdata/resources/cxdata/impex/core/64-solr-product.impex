# Facet search query properties
INSERT_UPDATE SolrSearchQueryProperty; indexedProperty(name, solrIndexedType(identifier))[unique = true]; facet[default = true]; facetType(code); priority; facetDisplayNameProvider         ; facetSortProvider; facetTopValuesProvider   ; includeInResponse[default = true]; searchQueryTemplate(name, indexedType(identifier))[unique = true][default = DEFAULT:$solrIndexedType]
#                                     ; allCategories:$solrIndexedType                      ;                      ; Refine         ; -9999   ;                                  ;                  ;                          ;                                  ;
                                     ; categoryPath:$solrIndexedType                                    ;                      ; Refine         ; -9999   ;                                  ;                  ;                          ;                                  ;
                                     ; category:$solrIndexedType                                        ;                      ; Refine         ; 6000    ; categoryFacetDisplayNameProvider ;                  ; defaultTopValuesProvider ;                                  ;
                                     ; price:$solrIndexedType                                           ;                      ; MultiSelectOr  ; 4000    ;                                  ;                  ; defaultTopValuesProvider ;                                  ;
                                     ; ean:$solrIndexedType                                             ;                      ; Refine         ; 3000    ;                                  ;                  ; defaultTopValuesProvider ;                                  ;

# Configuration of sortings
REMOVE SolrSort[batchmode = true]; indexedType(identifier)[unique = true]
                                 ; $solrIndexedType

# Define the available sorts
INSERT_UPDATE SolrSort; indexedType(identifier)[unique = true]; code[unique = true]; useBoost
                      ; $solrIndexedType                      ; relevance          ; true
                      ; $solrIndexedType                      ; topRated           ; false
                      ; $solrIndexedType                      ; name-asc           ; false
                      ; $solrIndexedType                      ; name-desc          ; false
                      ; $solrIndexedType                      ; price-asc          ; false
                      ; $solrIndexedType                      ; price-desc         ; false

# Define the sort fields
INSERT_UPDATE SolrSortField; sort(indexedType(identifier), code)[unique = true]; fieldName[unique = true]; ascending[unique = true]
                           ; $solrIndexedType:relevance                        ; inStockFlag             ; false
                           ; $solrIndexedType:relevance                        ; score                   ; false
                           ; $solrIndexedType:topRated                         ; inStockFlag             ; false
                           ; $solrIndexedType:topRated                         ; reviewAvgRating         ; false
                           ; $solrIndexedType:name-asc                         ; name                    ; true
                           ; $solrIndexedType:name-desc                        ; name                    ; false
                           ; $solrIndexedType:price-asc                        ; priceValue              ; true
                           ; $solrIndexedType:price-desc                       ; priceValue              ; false

# CronJob Definitions
INSERT_UPDATE SolrIndexerCronJob; code[unique = true] ; job(code)      ; singleExecutable; active; facetSearchConfig(name); indexerOperation(code); nodeGroup            ; sessionUser(uid); sessionCurrency(isocode); sessionLanguage(isocode)
                                ; $fullIndexCronJob   ; solrIndexerJob ; false           ; true  ; $solrConfigName        ; full                  ; backgroundProcessing ; admin           ; EUR                     ; en
                                ; $updateIndexCronJob ; solrIndexerJob ; false           ; true  ; $solrConfigName        ; update                ; backgroundProcessing ; admin           ; EUR                     ; en
                                ; $deleteIndexCronJob ; solrIndexerJob ; false           ; true  ; $solrConfigName        ; delete                ; backgroundProcessing ; admin           ; EUR                     ; en

INSERT_UPDATE Trigger; cronJob(code)[unique = true]; active; activationTime[dateformat = dd.MM.yyyy HH:mm:ss]; year; month; day; hour; minute; second; relative; weekInterval; daysOfWeek
                     ; $fullIndexCronJob           ; true  ; 01.01.2026 06:00:00                             ; -1  ; -1   ; -1 ; 6   ; 0     ; 0     ; false   ; 0           ;
                     ; $updateIndexCronJob         ; true  ; 01.01.2026 06:00:00                             ; -1  ; -1   ; -1 ; -1  ; -1    ; 35    ; false   ; 0           ;
                     ; $deleteIndexCronJob         ; true  ; 01.01.2026 06:00:00                             ; -1  ; -1   ; -1 ; -1  ; -1    ; 05    ; false   ; 0           ;
