# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryLang = $config-project.mydata.import.defaults.languages.primary
$secondaryLang = $config-project.mydata.import.defaults.languages.optional1
$contentCatalogId = $config-project.mydata.import.defaults.catalog.content.id
$contentCatalogEditVersion = $config-project.mydata.import.defaults.catalog.content.versions.edit
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $contentCatalogId]), CatalogVersion.version[default = $contentCatalogEditVersion])[unique = true, default = $contentCatalogId:$contentCatalogEditVersion]
$mediaResourcePath = jar:sap.commerce.project.data.constants.MyDataConstants&/mydata/assets/

# -----------------------------------------------------------------------
# 1. PAGE CREATION
# -----------------------------------------------------------------------
# Die Seite wird über das Label /dashboard erreichbar sein. 
# Zugriffsbeschränkungen regeln wir hier entweder über Frontend-Routing oder später durch CMS Restrictions.

INSERT_UPDATE ContentPage ; $contentCV[unique=true] ; uid[unique=true] ; name ; masterTemplate(uid,$contentCV) ; label ; defaultPage[default='true'] ; approvalStatus(code)[default='approved']
                          ; ; dashboard ; B2B Dashboard ; DashboardPageTemplate ; /dashboard ;

# -----------------------------------------------------------------------
# 2. PAGE SPECIFIC COMPONENTS
# -----------------------------------------------------------------------
# CMSFlexComponent als Platzhalter für das Frontend-gerenderte 6x4 Kachelsystem

INSERT_UPDATE CMSFlexComponent ; $contentCV[unique=true] ; uid[unique=true] ; name ; flexType
                               ; ; DashboardGridComponent ; Dashboard 6x4 Grid Component ; DashboardGridComponent

# -----------------------------------------------------------------------
# 3. PAGE SPECIFIC CONTENT SLOTS & MAPPING
# -----------------------------------------------------------------------

INSERT_UPDATE ContentSlot ; $contentCV[unique=true] ; uid[unique=true] ; name ; active ; cmsComponents(uid, $contentCV)
                          ; ; DashboardContentSlot ; Dashboard Content Slot ; true ; DashboardGridComponent

# -----------------------------------------------------------------------
# 4. BIND SLOTS TO PAGE
# -----------------------------------------------------------------------

INSERT_UPDATE ContentSlotForPage ; $contentCV[unique=true] ; uid[unique=true] ; position[unique=true] ; page(uid,$contentCV)[unique=true] ; contentSlot(uid,$contentCV)[unique=true]
                                 ; ; DashboardContent-dashboard ; DashboardContent ; dashboard ; DashboardContentSlot