# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryLang = $config-project.mydata.import.defaults.languages.primary
$secondaryLang = $config-project.mydata.import.defaults.languages.optional1
$contentCatalogId = $config-project.mydata.import.defaults.catalog.content.id
$contentCatalogEditVersion = $config-project.mydata.import.defaults.catalog.content.versions.edit
$contentCV = catalogVersion(CatalogVersion.catalog(Catalog.id[default = $contentCatalogId]), CatalogVersion.version[default = $contentCatalogEditVersion])[unique = true, default = $contentCatalogId:$contentCatalogEditVersion]
$mediaResourcePath = jar:sap.commerce.project.data.constants.MyDataConstants&/mydata/assets/

# -----------------------------------------------------------------------
# 1. PAGE CREATION
# -----------------------------------------------------------------------
# Wir legen die Homepage an und verknüpfen sie mit dem LandingPageTemplate
INSERT_UPDATE ContentPage ; $contentCV[unique=true] ; uid[unique=true] ; name ; masterTemplate(uid,$contentCV) ; label ; defaultPage[default='true'] ; approvalStatus(code)[default='approved'] ; homepage[default='true']
                          ; ; homepage ; Homepage ; LandingPageTemplate ; homepage ;

# -----------------------------------------------------------------------
# 2. PAGE SPECIFIC COMPONENTS (Zweisprachig)
# -----------------------------------------------------------------------

# Hero Banner (Visual Oben)
# Hinweis: Die eigentliche Bildzuweisung (MediaContainer) machen wir in einem separaten Media-Import oder fügen sie später hinzu. 
# Hier definieren wir zunächst nur die Komponente.
INSERT_UPDATE SimpleBannerComponent ; $contentCV[unique=true] ; uid[unique=true] ; name ; urlLink
                                    ; ; HomepageHeroBannerComponent ; Homepage Hero Banner ; /

# Paragraph Text (HTML/Rich-Text Bereich darunter)
INSERT_UPDATE CMSParagraphComponent ; $contentCV[unique=true] ; uid[unique=true] ; name ; content[lang=$primaryLang] ; content[lang=$secondaryLang]
                                    ; ; HomepageIntroTextComponent ; Homepage Intro Text ; "<div class='homepage-intro'><h1>Welcome to the Future of Robotics</h1><p>Discover our advanced industrial service robots and configure your tailored solution today.</p></div>" ; "<div class='homepage-intro'><h1>Willkommen in der Zukunft der Robotik</h1><p>Entdecken Sie unsere fortschrittlichen industriellen Service-Roboter und konfigurieren Sie noch heute Ihre maßgeschneiderte Lösung.</p></div>"

# -----------------------------------------------------------------------
# 3. PAGE SPECIFIC CONTENT SLOTS & MAPPING
# -----------------------------------------------------------------------
# Hier erzeugen wir die Instanzen der Slots für diese spezifische Seite 
# und weisen ihnen die eben erstellten Komponenten zu.

# Slot für das Banner (Section1)
INSERT_UPDATE ContentSlot ; $contentCV[unique=true] ; uid[unique=true] ; name ; active ; cmsComponents(uid, $contentCV)
                          ; ; Section1-HomepageSlot ; Section1 Slot for Homepage ; true ; HomepageHeroBannerComponent

# Slot für den Text (Section2)
INSERT_UPDATE ContentSlot ; $contentCV[unique=true] ; uid[unique=true] ; name ; active ; cmsComponents(uid, $contentCV)
                          ; ; Section2-HomepageSlot ; Section2 Slot for Homepage ; true ; HomepageIntroTextComponent

# -----------------------------------------------------------------------
# 4. BIND SLOTS TO PAGE
# -----------------------------------------------------------------------
# Mappe die Slots auf die Template-Positionen für diese spezifische Seite

INSERT_UPDATE ContentSlotForPage ; $contentCV[unique=true] ; uid[unique=true] ; position[unique=true] ; page(uid,$contentCV)[unique=true] ; contentSlot(uid,$contentCV)[unique=true]
                                 ; ; Section1-Homepage ; Section1 ; homepage ; Section1-HomepageSlot
                                 ; ; Section2-Homepage ; Section2 ; homepage ; Section2-HomepageSlot