"#% beforeEach:
    ImpExLineFilters.filterLocalizedLine(line, 1, ""$lang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/ProductHierarchy.csv"") , ""UTF-8"", new char[]{','}, 1, -1 );"

