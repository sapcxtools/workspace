# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"
"#% import me.cxdev.commerce.toolkit.impex.ImpExLineFilters;"
"#% import sap.commerce.project.data.constants.MyDataConstants;"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryCurrency = $config-project.mydata.import.defaults.currency.primary
$primaryLang = $config-project.mydata.import.defaults.languages.primary
$siteId = $config-project.mydata.import.defaults.site.id
$siteName = $config-project.mydata.import.defaults.site.name
$storeId = $config-project.mydata.import.defaults.store.id
$storeName = $config-project.mydata.import.defaults.store.name
$productCatalogId = $config-project.mydata.import.defaults.catalog.product.id
$productCatalogName = $config-project.mydata.import.defaults.catalog.product.name
$productCatalogEditVersion = $config-project.mydata.import.defaults.catalog.product.versions.edit
$productCatalogLiveVersion = $config-project.mydata.import.defaults.catalog.product.versions.live

# -----------------------------------------------------------------------
# 1. USER GROUPS
# -----------------------------------------------------------------------

# Ensure foundational User Groups are available
INSERT_UPDATE UserGroup; uid[unique = true]
                       ; admingroup
                       ; employeegroup
                       ; productmanagergroup
                       ; customergroup

# -----------------------------------------------------------------------
# 2. PRODUCT CATALOG CREATION
# -----------------------------------------------------------------------

# Product catalog
INSERT_UPDATE Catalog; id[unique = true] ; name[lang = $primaryLang]; baseStores(uid)
                     ; $productCatalogId ; $productCatalogName      ; $storeId

# Catalog Versions
INSERT_UPDATE CatalogVersion; catalog(id)[unique = true]; version[unique = true]     ; active; languages(isocode); readPrincipals(uid)          ; writePrincipals(uid)
                            ; $productCatalogId         ; $productCatalogEditVersion ; false ; $primaryLang      ; employeegroup                ; admingroup, productmanagergroup
                            ; $productCatalogId         ; $productCatalogLiveVersion ; true  ; $primaryLang      ; employeegroup, customergroup ; admingroup, productmanagergroup

UPDATE CatalogVersion;;;;;;;;;;;;;;;;;;;;; catalog(id)[unique = true]; version[unique = true]; languages(isocode)
"#% beforeEach:
    line.put(21, ""$productCatalogId"");
    line.put(22, ""$productCatalogEditVersion"");
    if (""true"".equals(line.get(3))) line.put(23, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(23, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"
"#% beforeEach:
    line.put(21, ""$productCatalogId"");
    line.put(22, ""$productCatalogLiveVersion"");
    if (""true"".equals(line.get(3))) line.put(23, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(23, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"


# -----------------------------------------------------------------------
# 3. SYNCHRONIZATION JOB
# -----------------------------------------------------------------------

$productCatalogSync = $productCatalogId ($productCatalogEditVersion -> $productCatalogLiveVersion)

# Cleanup existing job if present
REMOVE CatalogVersionSyncJob; code[unique = true]
                            ; $productCatalogSync

# Create new Sync Job tailored for products
INSERT_UPDATE CatalogVersionSyncJob; code[unique = true] ; sourceVersion(catalog(id), version)          ; targetVersion(catalog(id), version)          ; syncLanguages(isocode); rootTypes(code)                ; active; createNewItems; removeMissingItems; enableTransactions; maxSchedulerThreads; maxThreads; copyCacheSize; syncPrincipals(uid)
                                   ; $productCatalogSync ; $productCatalogId:$productCatalogEditVersion ; $productCatalogId:$productCatalogLiveVersion ; $primaryLang          ; CMSItem, Media, MediaContainer ; true  ; true          ; true              ; false             ; 1                  ; 1         ; 5000         ; cmsmanagergroup

INSERT_UPDATE CatalogVersionSyncJob;;;;;;;;;;;;;;;;;;;;; code[unique = true]; syncLanguages(isocode)
"#% beforeEach:
    line.put(21, ""$productCatalogSync"");
    if (""true"".equals(line.get(3))) line.put(22, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(22, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"


# Configure specific attributes for the sync job (optional, but good practice to exclude specific transient fields if needed later)
INSERT_UPDATE SyncAttributeDescriptorConfig; syncJob(code)[unique = true]; attributeDescriptor(enclosingType(code), qualifier)[unique = true]; includedInSync; copyByValue
# Remove Product Attributes that we do not need  -> ~15% boost
                                           ; $productCatalogSync         ; Item:comments                                                     ; false         ; true ;
                                           ; $productCatalogSync         ; Product:barcodes                                                  ; false         ; true ;
                                           ; $productCatalogSync         ; Product:deliveryModes                                             ; false         ; true ;
                                           ; $productCatalogSync         ; Product:futureStocks                                              ; false         ; true ;
                                           ; $productCatalogSync         ; Product:keywords                                                  ; false         ; true ;
                                           ; $productCatalogSync         ; Product:productOrderLimit                                         ; false         ; true ;
                                           ; $productCatalogSync         ; Product:productReviews                                            ; false         ; true ;
                                           ; $productCatalogSync         ; Product:promotions                                                ; false         ; true ;
                                           ; $productCatalogSync         ; Product:restrictions                                              ; false         ; true ;
                                           ; $productCatalogSync         ; Product:stockLevels                                               ; false         ; true ;
                                           ; $productCatalogSync         ; Product:vendors                                                   ; false         ; true ;
                                           ; $productCatalogSync         ; Product:linkComponents                                            ; false         ; true ;
                                           ; $productCatalogSync         ; Product:productCarouselComponents                                 ; false         ; true ;
                                           ; $productCatalogSync         ; Product:productDetailComponents                                   ; false         ; true ;
                                           ; $productCatalogSync         ; Product:productFeatureComponents                                  ; false         ; true ;
                                           ; $productCatalogSync         ; Product:productListComponents                                     ; false         ; true ;
                                           ; $productCatalogSync         ; Product:detail                                                    ; false         ; true ;
                                           ; $productCatalogSync         ; Product:logo                                                      ; false         ; true ;
                                           ; $productCatalogSync         ; Product:normal                                                    ; false         ; true ;
                                           ; $productCatalogSync         ; Product:thumbnails                                                ; false         ; true ;
                                           ; $productCatalogSync         ; Product:thumbnail                                                 ; false         ; true ;
# Remove not needed Category attributes -> ~ 10% for Category sync
                                           ; $productCatalogSync         ; Category:productCarouselComponents                                ; false         ; true ;
                                           ; $productCatalogSync         ; Category:productListComponents                                    ; false         ; true ;
                                           ; $productCatalogSync         ; Category:restrictions                                             ; false         ; true ;
                                           ; $productCatalogSync         ; Category:promotions                                               ; false         ; true ;
                                           ; $productCatalogSync         ; Category:others                                                   ; false         ; true ;
                                           ; $productCatalogSync         ; Category:data_sheet                                               ; false         ; true ;
                                           ; $productCatalogSync         ; Category:detail                                                   ; false         ; true ;
                                           ; $productCatalogSync         ; Category:logo                                                     ; false         ; true ;
                                           ; $productCatalogSync         ; Category:thumbnail                                                ; false         ; true ;
                                           ; $productCatalogSync         ; Category:thumbnails                                               ; false         ; true ;