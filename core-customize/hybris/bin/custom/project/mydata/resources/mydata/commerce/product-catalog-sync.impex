# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"
"#% import me.cxdev.commerce.toolkit.impex.ImpExTasks;"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$productCatalogId = $config-project.mydata.import.defaults.catalog.product.id
$productCatalogEditVersion = $config-project.mydata.import.defaults.catalog.product.versions.edit
$productCatalogLiveVersion = $config-project.mydata.import.defaults.catalog.product.versions.live

# -----------------------------------------------------------------------
# 1. START CATALOG SYNCHRONIZATION
# -----------------------------------------------------------------------

$productCatalogSync = $productCatalogId ($productCatalogEditVersion -> $productCatalogLiveVersion)

"#% ImpExTasks.startFullCatalogSync(""$productCatalogId:$productCatalogEditVersion"", ""$productCatalogId:$productCatalogLiveVersion"", ""$productCatalogSync"");"
