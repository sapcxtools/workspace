# -----------------------------------------------------------------------
# BeanShell imports
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"
"#% import org.apache.commons.lang3.StringUtils;"
"#% import org.apache.commons.io.FilenameUtils;"
"#% import me.cxdev.commerce.toolkit.impex.ImpExLineFilters;"
"#% import sap.commerce.project.data.constants.MyDataConstants;"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryCurrency = $config-project.mydata.import.defaults.currency.primary
$secondaryCurrency = $config-project.mydata.import.defaults.currency.secondary
$primaryLang = $config-project.mydata.import.defaults.languages.primary
$secondaryLang = $config-project.mydata.import.defaults.languages.secondary
$siteId = $config-project.mydata.import.defaults.site.id
$siteName = $config-project.mydata.import.defaults.site.name
$storeId = $config-project.mydata.import.defaults.store.id
$storeName = $config-project.mydata.import.defaults.store.name
$vendorId = $config-project.mydata.import.defaults.vendor.id
$vendorName = $config-project.mydata.import.defaults.vendor.name
$warehouseId = $config-project.mydata.import.defaults.warehouse.id
$warehouseName = $config-project.mydata.import.defaults.warehouse.name

$requiresAuthentication = $config-project.mydata.import.defaults.requiresauthentication
$enableRegistration = $config-project.mydata.import.defaults.enableregistration
$useNetValues = $config-project.mydata.import.defaults.usenetvalues

# -----------------------------------------------------------------------
# Minimal Vendor & Warehouse setup
# -----------------------------------------------------------------------
INSERT_UPDATE Vendor; code[unique = true]; name[lang = $primaryLang]
                    ; $vendorId          ; $vendorName

INSERT_UPDATE Warehouse; code[unique = true]; name[lang = $primaryLang]; vendor(code); default
                       ; $warehouseId       ; $warehouseName           ; $vendorId   ; true

# -----------------------------------------------------------------------
# BaseStore
# -----------------------------------------------------------------------
INSERT_UPDATE BaseStore; uid[unique = true]; name[lang = $primaryLang]; warehouses(code); languages(isocode); defaultLanguage(isocode); currencies(isocode); defaultCurrency(isocode); net           ; productSearchStrategy
                       ; $storeId          ; $storeName               ; $warehouseId    ; $primaryLang      ; $primaryLang            ; $primaryCurrency   ; $primaryCurrency        ; $useNetValues ; commerceSolrFacetSearchProductSearchStrategy

UPDATE BaseStore;;;;;;;;;;;;;;;;;;;;; uid[unique = true]; languages(isocode)
"#% beforeEach:
    line.put(21, ""$storeId"");
    if (""true"".equals(line.get(3))) line.put(22, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(22, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"

UPDATE BaseStore;;;;;;;;;;;;;;;;;;;;; uid[unique = true]; currencies(isocode)
"#% beforeEach:
    line.put(21, ""$storeId"");
    if (""true"".equals(line.get(6))) line.put(22, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(6))) line.put(22, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Currencies.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"

UPDATE BaseStore;;;;;;;;;;;;;;;;;;;;; uid[unique = true]; billingCountries(isocode); deliveryCountries(isocode)
"#% beforeEach:
    line.put(21, ""$storeId"");
    if (""true"".equals(line.get(3))) line.put(22, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(22, ""(-) "" + line.get(2));
    line.put(23, line.get(22));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Countries.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"
