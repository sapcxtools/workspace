# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"
"#% import me.cxdev.commerce.toolkit.impex.ImpExLineFilters;"
"#% import sap.commerce.project.data.constants.MyDataConstants;"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryCurrency = $config-project.mydata.import.defaults.currency.primary
$primaryLang = $config-project.mydata.import.defaults.languages.primary
$siteId = $config-project.mydata.import.defaults.site.id
$siteName = $config-project.mydata.import.defaults.site.name
$storeId = $config-project.mydata.import.defaults.store.id
$storeName = $config-project.mydata.import.defaults.store.name
$contentCatalogId = $config-project.mydata.import.defaults.catalog.content.id
$contentCatalogName = $config-project.mydata.import.defaults.catalog.content.name
$contentCatalogEditVersion = $config-project.mydata.import.defaults.catalog.content.versions.edit
$contentCatalogLiveVersion = $config-project.mydata.import.defaults.catalog.content.versions.live

# -----------------------------------------------------------------------
# 1. USER GROUPS
# -----------------------------------------------------------------------

# Ensure foundational User Groups are available
INSERT_UPDATE UserGroup; uid[unique = true]
                       ; admingroup
                       ; employeegroup
                       ; contentmanagergroup
                       ; customergroup
                       ; cmsmanagergroup

# -----------------------------------------------------------------------
# 2. CONTENT CATALOG CREATION
# -----------------------------------------------------------------------

# Content catalog
INSERT_UPDATE ContentCatalog; id[unique = true] ; name[lang = $primaryLang]; cmsSites(uid)
                            ; $contentCatalogId ; $contentCatalogName      ; $siteId

# Catalog Versions
INSERT_UPDATE CatalogVersion; catalog(id)[unique = true]; version[unique = true]     ; active; languages(isocode); readPrincipals(uid)          ; writePrincipals(uid)
                            ; $contentCatalogId         ; $contentCatalogEditVersion ; false ; $primaryLang      ; employeegroup                ; admingroup, contentmanagergroup, cmsmanagergroup
                            ; $contentCatalogId         ; $contentCatalogLiveVersion ; true  ; $primaryLang      ; employeegroup, customergroup ; admingroup, contentmanagergroup, cmsmanagergroup

UPDATE CatalogVersion;;;;;;;;;;;;;;;;;;;;; catalog(id)[unique = true]; version[unique = true]; languages(isocode)
"#% beforeEach:
    line.put(21, ""$contentCatalogId"");
    line.put(22, ""$contentCatalogEditVersion"");
    if (""true"".equals(line.get(3))) line.put(23, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(23, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"
"#% beforeEach:
    line.put(21, ""$contentCatalogId"");
    line.put(22, ""$contentCatalogLiveVersion"");
    if (""true"".equals(line.get(3))) line.put(23, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(23, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"


# -----------------------------------------------------------------------
# 3. SYNCHRONIZATION JOB
# -----------------------------------------------------------------------

$contentCatalogSync = $contentCatalogId ($contentCatalogEditVersion -> $contentCatalogLiveVersion)

# Cleanup existing job if present
REMOVE CatalogVersionSyncJob; code[unique = true]
                            ; $contentCatalogSync

# Create new Sync Job tailored for CMS Content
INSERT_UPDATE CatalogVersionSyncJob; code[unique = true] ; sourceVersion(catalog(id), version)          ; targetVersion(catalog(id), version)          ; syncLanguages(isocode); rootTypes(code)                                                                                                                                                             ; active; createNewItems; removeMissingItems; enableTransactions; maxSchedulerThreads; maxThreads; copyCacheSize; syncPrincipals(uid)
                                   ; $contentCatalogSync ; $contentCatalogId:$contentCatalogEditVersion ; $contentCatalogId:$contentCatalogLiveVersion ; $primaryLang          ; CMSItem, Media, MediaContainer ; true  ; true          ; true              ; false             ; 1                  ; 1         ; 5000         ; cmsmanagergroup

INSERT_UPDATE CatalogVersionSyncJob;;;;;;;;;;;;;;;;;;;;; code[unique = true]; syncLanguages(isocode)
"#% beforeEach:
    line.put(21, ""$contentCatalogSync"");
    if (""true"".equals(line.get(3))) line.put(22, ""(+) "" + line.get(2));
    if (""false"".equals(line.get(3))) line.put(22, ""(-) "" + line.get(2));
    ImpExLineFilters.filterUnlocalizedOrPrimaryLine(line, 1, ""$primaryLang"");"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csv/Languages.csv""), ""UTF-8"", new char[]{','}, 1, -1 );"


# Configure specific attributes for the sync job (optional, but good practice to exclude specific transient fields if needed later)
INSERT_UPDATE SyncAttributeDescriptorConfig; syncJob(code)[unique = true]; attributeDescriptor(enclosingType(code), qualifier)[unique = true]; includedInSync; copyByValue
