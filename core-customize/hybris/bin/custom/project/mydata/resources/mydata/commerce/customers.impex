# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"
"#% import me.cxdev.commerce.toolkit.impex.ImpExLineFilters;"
"#% import sap.commerce.project.data.constants.MyDataConstants;"
"#% import org.apache.commons.lang3.StringUtils;"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$primaryCurrency = $config-project.mydata.import.defaults.currency.primary
$primaryLang = $config-project.mydata.import.defaults.languages.primary

# -----------------------------------------------------------------------
# 1. B2B UNITS (Companies.csv)
# -----------------------------------------------------------------------
# 2: Customer (ID), 3: Parent, 4: Name
INSERT_UPDATE B2BUnit; uid[unique = true]; locName[lang=$primaryLang]; groups(uid); active[default=true]
"#% beforeEach:
    String parent = line.get(3);
    line.put(21, StringUtils.isBlank(parent) ? ""b2bgroup"" : parent);
    ImpExLineFilters.filterUnlocalizedLine(line, 1);"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csvs/Companies.csv"") , ""UTF-8"", new char[]{','}, 1, 1 );"

# -----------------------------------------------------------------------
# 2. MAIN UNIT ADDRESSES (Companies.csv)
# -----------------------------------------------------------------------
# 2: Customer (ID), 6: SAPPublicKey, 8: Street, 9: Number, 10: Postal Code, 11: City, 12: Country
INSERT_UPDATE Address; owner(B2BUnit.uid)[unique = true]; streetname; streetnumber; postalcode; town; country(isocode); publicKey[unique = true]; billingAddress[default=true]; shippingAddress[default=true]; contactAddress[default=true]
"#% beforeEach:
    ImpExLineFilters.filterUnlocalizedLine(line, 1);"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csvs/Companies.csv"") , ""UTF-8"", new char[]{','}, 1, 1 );"

# -----------------------------------------------------------------------
# 3. ADDITIONAL ADDRESSES (Addresses.csv)
# -----------------------------------------------------------------------
# 2: UUID, 3: OrgID, 4: SapPublicKey, 6: Billing, 7: Shipping, 9: Contact, 10: AdrBook, 11: Company, 12: Street, 13: Number, 14: Postal Code, 15: City, 16: Country
INSERT_UPDATE Address; id[unique = true]; owner(B2BUnit.uid); publicKey; billingAddress; shippingAddress; contactAddress; visibleInAddressBook; company; streetname; streetnumber; postalcode; town; country(isocode)
"#% beforeEach:
    ImpExLineFilters.filterUnlocalizedLine(line, 1);"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csvs/Addresses.csv"") , ""UTF-8"", new char[]{','}, 1, -1 );"

# -----------------------------------------------------------------------
# 4. B2B CUSTOMERS (Users.csv)
# -----------------------------------------------------------------------
# 3: OrgID (Unit), 17: First Name, 18: Last Name, 19: Email (UID), 21: Groups
INSERT_UPDATE B2BCustomer; uid[unique = true]; name; email; defaultB2BUnit(uid); groups(uid); sessionLanguage(isocode)[default=$primaryLang]; sessionCurrency(isocode)[default=$primaryCurrency]; password[default='12341234']
"#% beforeEach:
    line.put(21, line.get(17) + "" "" + line.get(18));
    String groups = line.get(21);
    line.put(22, StringUtils.isNotBlank(groups) ? groups + "",b2bcustomergroup"" : ""b2bcustomergroup"");
    ImpExLineFilters.filterUnlocalizedLine(line, 1);"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csvs/Users.csv"") , ""UTF-8"", new char[]{','}, 1, 4 );"

# -----------------------------------------------------------------------
# 5. PERSONAL CUSTOMER ADDRESSES (Users.csv)
# -----------------------------------------------------------------------
# 2: UUID, 6: Billing, 7: Shipping, 9: Contact, 10: AdrBook, 11: Company, 12: Line1, 13: Line2, 14: Postal Code, 15: City, 16: Country, 17: First, 18: Last, 19: Email (Owner), 20: Phone
INSERT_UPDATE Address; id[unique = true]; owner(Principal.uid)[unique = true]; firstname; lastname; company; line1; line2; postalcode; town; country(isocode); phone1; billingAddress; shippingAddress; contactAddress; visibleInAddressBook
"#% beforeEach:
    line.put(21, line.get(2) + ""_ADDR"");
    ImpExLineFilters.filterUnlocalizedLine(line, 1);"
"#% impex.includeExternalData(MyDataConstants.class.getResourceAsStream(""/mydata/erp/csvs/Users.csv"") , ""UTF-8"", new char[]{','}, 1, 4 );"
