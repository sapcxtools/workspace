# -----------------------------------------------------------------------
# BeanShell imports & Locale setup
# -----------------------------------------------------------------------
"#% impex.setLocale(Locale.ENGLISH);"
"#% import me.cxdev.commerce.toolkit.impex.ImpExTasks;"

# -----------------------------------------------------------------------
# DEFAULT MACROS
# -----------------------------------------------------------------------
UPDATE GenericItem[processor = de.hybris.platform.commerceservices.impex.impl.ConfigPropertyImportProcessor]; pk[unique = true]
$contentCatalogId = $config-project.mydata.import.defaults.catalog.content.id
$contentCatalogEditVersion = $config-project.mydata.import.defaults.catalog.content.versions.edit
$contentCatalogLiveVersion = $config-project.mydata.import.defaults.catalog.content.versions.live

# -----------------------------------------------------------------------
# 1. START CATALOG SYNCHRONIZATION
# -----------------------------------------------------------------------

$contentCatalogSync = $contentCatalogId ($contentCatalogEditVersion -> $contentCatalogLiveVersion)

"#% ImpExTasks.startFullCatalogSync(""$contentCatalogId:$contentCatalogEditVersion"", ""$contentCatalogId:$contentCatalogLiveVersion"", ""$contentCatalogSync"");"
