               ;                      ;               ;         ; PriceRow                                       ; +     ; +     ; +     ; +; +;
               ;                      ;               ;         ; ProductFeature                                 ; +     ; +     ; +     ; +; +;
               ;                      ;               ;         ; ProductReference                               ; +     ; +     ; +     ; +; +;
               ;                      ;               ;         ; Warehouse                                      ; +     ; +     ; +     ; +; +;
